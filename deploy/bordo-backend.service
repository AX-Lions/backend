# Bordo 백엔드 상시 실행 유닛
#
#   sudo cp deploy/bordo-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bordo-backend
#
# 경로가 /srv/bordo/backend 가 아니면 아래 세 줄(WorkingDirectory·EnvironmentFile·
# ExecStart)과 RequiresMountsFor 를 바꾸십시오.

[Unit]
Description=Bordo 백엔드 (gunicorn)
Documentation=https://github.com/AX-Lions/backend

# 코드와 DB 가 별도 볼륨에 있습니다. 마운트 전에 뜨면 빈 디렉터리를 보고
# 엉뚱한 곳에 파일을 만들기 시작합니다 — 이 프로젝트에서 실제로 겪은 실패입니다.
RequiresMountsFor=/srv/bordo

# DB 는 컨테이너입니다. docker 가 준비된 뒤에 뜨게 합니다.
After=network-online.target docker.service
Wants=network-online.target
After=srv-bordo.mount

[Service]
Type=notify
User=zanviq
Group=zanviq
WorkingDirectory=/srv/bordo/backend
EnvironmentFile=/srv/bordo/backend/.env

ExecStart=/srv/bordo/backend/.venv/bin/gunicorn \
    --config /srv/bordo/backend/deploy/gunicorn.conf.py \
    config.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID

# 죽으면 되살립니다. 다만 설정 오류로 즉시 죽는 경우 무한 재시작을 막기 위해
# 5분에 5회를 넘으면 멈추고 상태를 failed 로 남깁니다 — 조용히 재시작을 반복하면
# 문제를 눈치채지 못합니다.
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

# DB 커넥션과 워커가 정리될 시간.
TimeoutStopSec=30
KillSignal=SIGTERM

# 같은 서버에 다른 프로젝트가 돌고 있습니다. 이 서비스가 폭주해도
# 나머지가 함께 죽지 않도록 상한을 둡니다.
MemoryMax=2G
TasksMax=256

# 최소 권한. 쓰기가 필요한 곳만 열어 둡니다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/srv/bordo

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bordo-backend

[Install]
WantedBy=multi-user.target
