# Discord Developer Portal에서 발급받은 봇 토큰
DISCORD_TOKEN=

# Backend 호출용 인증 시크릿 (DISCORD_TOKEN과 별개). Backend가 생기기 전까지는 임의 문자열 가능
BORDO_SERVICE_TOKEN=

# 선택 — 기본값 http://localhost:8000
BORDO_BACKEND_URL=http://localhost:8000

# 선택 — Outbox 폴링 주기(초). 정의만 돼 있고 현재는 사용되지 않음
BORDO_OUTBOX_INTERVAL=3

# 사람 접속 상태를 대리 참석 보조 신호로 보낼지.
#
# **Discord 개발자 포털에서 Presence Intent 와 Server Members Intent 를 먼저
# 켜야 합니다.** 안 켠 채로 이것만 1 로 두면 봇이 연결 단계에서 죽습니다.
# 기본은 꺼짐 — 보조 신호 하나 때문에 봇 전체가 안 뜨는 것이 더 나쁩니다.
BORDO_PRESENCE_INTENT=0
