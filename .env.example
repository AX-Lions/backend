# 이 파일을 .env 로 복사해 값을 채웁니다. .env 는 커밋하지 않습니다.
#
# 임시 서버(라즈베리파이)에서 대회 측 서버로 옮길 때, 코드는 그대로 두고
# 이 파일의 값만 바꿉니다. 경로·주소·토큰을 코드에 넣지 마십시오.

# ─────────────────────────────────────────── Django
DJANGO_SECRET_KEY=change-me
# 운영에서는 반드시 0 입니다. 1 이면 오류 화면에 소스와 설정이 그대로 나갑니다.
DJANGO_DEBUG=1

# ─────────────────────────────────────────── 데이터베이스
# 비우면 SQLite 를 씁니다. 운영은 pgvector 때문에 PostgreSQL 전제입니다.
# 비밀번호에 @ / # 같은 문자가 있으면 URL 인코딩해서 넣으십시오.
# DATABASE_URL=postgresql://bordo:change-me@127.0.0.1:5433/bordo

# 위 DATABASE_URL 과 아래 값들은 같은 DB 를 가리켜야 합니다.
# deploy/docker-compose.db.yml 이 아래 값으로 컨테이너를 띄웁니다.
POSTGRES_DB=bordo
POSTGRES_USER=bordo
POSTGRES_PASSWORD=
# 서버에 다른 프로젝트의 PostgreSQL 이 있어 기본 5432 를 피합니다.
POSTGRES_PORT=5433

# DB 파일이 실제로 저장되는 위치. 서버에서는 SD카드가 아닌 전용 볼륨입니다.
# 로컬 개발이면 비워 두면 됩니다(저장소 안 ./data 를 씁니다).
BORDO_DATA_DIR=

# 커넥션 재사용 시간(초). 0 이면 요청마다 새로 연결합니다.
DJANGO_CONN_MAX_AGE=60

# ─────────────────────────────────────────── 토큰
# Discord Bot 이 /internal/v1 을 부를 때 씁니다.
BORDO_SERVICE_TOKEN=dev-service-token

# MCP 토큰 발급 응답의 setup_command 에 찍히는 서버 주소. 비우면 요청 Host 로 만듭니다.
# BORDO_PUBLIC_URL=https://api.bordo.dev

# ─────────────────────────────────────────── 배포
# 외부 노출은 Cloudflare Tunnel 이 맡습니다.
#
# 서버가 NAT 뒤에 있어 밖에서 직접 들어올 수 없습니다(SSH 만 포워딩). 터널은
# **나가는 연결**로 트래픽을 받으므로 포트를 열 필요가 없습니다.
#
# 토큰은 Cloudflare Zero Trust → Networks → Tunnels → Configure 에서 복사합니다.
# 대시보드의 public hostname 이 프론트 컨테이너(http://localhost:8020)를 가리키게
# 두면, 그 뒤 API 는 컨테이너 nginx 가 8010 으로 넘깁니다.
#
# **이 값이 없으면 서비스는 멀쩡히 뜨는데 밖에서 아무도 못 들어옵니다.** 서버를
# 옮길 때 가장 놓치기 쉬운 항목이라 여기 적어 둡니다.
CLOUDFLARE_TUNNEL_TOKEN=

# gunicorn 이 붙는 주소. 위 터널이 여기로 넘기므로 루프백입니다.
# 8000 은 서버에서 다른 프로젝트가 쓰고 있어 피합니다.
BORDO_BIND=127.0.0.1:8010
BORDO_WORKERS=
BORDO_TIMEOUT=120
BORDO_LOG_LEVEL=info

# 도메인이 붙으면 반드시 채웁니다. 비워 두고 DJANGO_DEBUG=0 이면 모든 요청이 400 입니다.
# 예) api.bordo.dev,127.0.0.1
DJANGO_ALLOWED_HOSTS=
# 예) https://api.bordo.dev
DJANGO_CSRF_TRUSTED_ORIGINS=
# 프론트 주소. 비우면 전체 허용(개발용)입니다. 예) https://bordo.dev
DJANGO_CORS_ALLOWED_ORIGINS=

# ─────────────────────────────────────────── LLM
# 없으면 대리인이 **조용히** 아무 말도 하지 않습니다. 서버는 정상으로 뜹니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# 한 번의 LLM 호출을 기다리는 시간(초). 기본 20.
# SDK 기본값 600초를 그대로 쓰면 회의 중 OpenAI 가 느려질 때
# 봇 요청 스레드가 통째로 묶입니다.
# OPENAI_TIMEOUT_SEC=20

# ─────────────────────────────────────────── 시연 시드 (seed_showcase)
# 영상 촬영용 데이터셋이 쓸 Discord 값입니다. `manage.py seed_showcase` 를
# 돌릴 때만 읽습니다.
#
# **비워 두면 Discord 연결을 만들지 않습니다.** 아무 번호나 채우는 것보다
# 낫습니다 — 화면은 `연결됨` 이라고 말하는데 봇이 보낸 발언은 어느 팀에도
# 안 붙어, 회의는 열리는데 대리인만 조용한 상태가 됩니다.
# SHOWCASE_GUILD_ID=
# SHOWCASE_DISCORD_LEAD=
# SHOWCASE_DISCORD_AWAY=
# SHOWCASE_DISCORD_MEMBER=

# ─────────────────────────────────────────── 실시간 · 비동기
# 비우면 Channels 가 인메모리로 떨어집니다. 오류는 안 나고 이벤트만
# 사람마다 다르게 보입니다 — 찾기 가장 어려운 종류입니다.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# 운영에서는 반드시 0 입니다. 1 이면 요청 스레드가 LLM 호출을 통째로 기다립니다.
CELERY_TASK_ALWAYS_EAGER=0

# 채팅 첨부를 둘 자리. 비우면 저장소 폴더 안의 `media/` 입니다.
#
# `/media/` 로 그대로 서빙하지 않습니다 — 주소만 알면 누구나 받게 되는데,
# 첨부는 그 방 참여자만 봐야 합니다. 내려받기는 권한을 보는 뷰를 지납니다.
# DJANGO_MEDIA_ROOT=

# 첨부 한 개의 상한(바이트). 기본 20MB.
# CHAT_ATTACHMENT_MAX_BYTES=20971520
